<Window x:Class="RegistrationWindow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RegistrationWindow"
        xmlns:userControls="clr-namespace:RegistrationWindow.UserControls"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Background" Value="LightBlue"/>

        </Style>
    </Window.Style>
    <Window.Resources>
        <Style x:Key="StackPanel" TargetType="StackPanel">

        </Style>
        <Style x:Key="BaseTextStyle" TargetType="Control">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>

            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Width" Value="350"/>
        </Style>

        <Style x:Key="EnterButton" TargetType="Button">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontStyle" Value="Normal"/>
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="Content" Value="Login"/>
            <Setter Property="Margin" Value="5"/>

            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Width" Value="350"/>
        </Style>

        <Style x:Key="TextBox" TargetType="TextBox" BasedOn="{StaticResource BaseTextStyle}"/>

        <Style x:Key="PasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource BaseTextStyle}"/>
    </Window.Resources>



    <Grid>
        <Border Grid.Column="0"
                 BorderBrush="Gray" 
                 BorderThickness="4" 
                 CornerRadius="10"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Width="400"
                 Height="200"
                 >

            <StackPanel Margin="20">

                <!-- Привязываем к свойствам ViewModel -->
                <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,10"
                 Height="30"/>

                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
  Margin="0,0,0,10"
  Height="30"/>

                <Button Content="Войти" 
                Command="{Binding RegisterCommand}"
                Height="30"/>

            </StackPanel>

        </Border>
        <StackPanel x:Name="TestBox" Style="{StaticResource StackPanel}"/>
    </Grid >
</Window>
